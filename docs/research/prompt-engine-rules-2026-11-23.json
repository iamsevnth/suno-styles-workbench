{
  "title": "Suno Workbench Prompt-Engine Starter Rules",
  "schema_version": "1.0.0",
  "verified_on": "2026-11-23",
  "scope": "Suno V6 / MCP plus platform-neutral bass music prompt semantics",
  "evidence_status": "mixed_official_connected_music_heuristics",
  "notes": [
    "This is a starter configuration, not an official Suno schema.",
    "Tempo ranges and slider presets are hypotheses, not hard genre rules.",
    "Always refresh live connector schema and Suno official sources before deployment.",
    "Do not submit generation requests without explicit user intent and credit controls."
  ],
  "provider": {
    "name": "Suno",
    "models_available_in_connected_account_at_check": [
      "v6-mini",
      "v6",
      "v6-wild"
    ],
    "connector_limits": {
      "style_max_chars": 1000,
      "negative_style_max_chars": 1000,
      "lyrics_max_chars": 5000,
      "simple_description_max_chars": 3000,
      "duration_target_seconds": [
        15,
        360
      ],
      "dedicated_mashup_sources": 2,
      "simple_reference_sources_max": 10
    },
    "general_v6_product_max_duration_minutes_official": 8,
    "control_schema": {
      "weirdness": {
        "min": 0.0,
        "max": 1.0,
        "meaning": "novelty_and_unpredictability"
      },
      "style_influence": {
        "min": 0.0,
        "max": 1.0,
        "meaning": "written_style_adherence"
      },
      "audio_influence": {
        "min": 0.0,
        "max": 1.0,
        "meaning": "source_or_voice_conditioning_route_dependent"
      },
      "variety": {
        "enum": {
          "0": "Off",
          "1": "Normal",
          "2": "High",
          "3": "Extra",
          "4": "Max"
        },
        "meaning": "reinterprets_style_tags"
      },
      "max_mode": {
        "type": "boolean",
        "meaning": "extra_compute_and_credits_for_consistency_not_source_mix"
      }
    },
    "operation_constraints": {
      "custom": {
        "no_description": true,
        "style_allowed": true,
        "lyrics_allowed": true,
        "vocal_gender_allowed": true,
        "instrumental_allowed": true,
        "audio_influence_only_with_voice_id": true
      },
      "simple": {
        "description_required": true,
        "style_disallowed": true,
        "custom_lyrics_disallowed": true,
        "reference_audio_ids_max": 10
      },
      "cover_dedicated": {
        "sources": 1,
        "style_allowed": true,
        "source_audio_influence_allowed": true,
        "lyrics_not_inherited_when_omitted": true,
        "voice_id_allowed": true
      },
      "mashup_dedicated": {
        "sources": 2,
        "style_allowed": true,
        "audio_influence_joint_for_both_sources": true,
        "vocal_gender_field_not_exposed": true
      },
      "extend_dedicated": {
        "sources": 1,
        "continue_at_required": true,
        "instrumental_allowed": true,
        "source_audio_influence_allowed": true
      }
    }
  },
  "six_part_prompt": {
    "identity": {
      "required": [
        "primary_genre",
        "primary_groove_role",
        "tempo",
        "mood"
      ],
      "optional": [
        "key",
        "meter",
        "secondary_styles",
        "energy"
      ]
    },
    "groove": {
      "required": [
        "kick_placement",
        "backbeat",
        "hat_timbre",
        "hat_base_grid"
      ],
      "optional": [
        "hat_fills",
        "open_hat_role",
        "ghost_notes",
        "swing",
        "section_changes"
      ]
    },
    "musical_identity": {
      "required": [
        "primary_hook",
        "bass_sub_role",
        "bass_mid_role",
        "hook_recurrence"
      ],
      "optional": [
        "harmony",
        "countermelody",
        "call_response"
      ]
    },
    "arrangement": {
      "required": [
        "sections",
        "final_drop_delta"
      ],
      "optional": [
        "bar_count",
        "build_mechanism",
        "contrast",
        "transition_cues"
      ]
    },
    "production": {
      "required": [
        "low_end_priority",
        "transient_priority"
      ],
      "optional": [
        "stereo_width",
        "reverb",
        "distortion_band",
        "sidechain"
      ]
    },
    "constraints": {
      "required": [
        "must_preserve",
        "must_exclude"
      ],
      "optional": [
        "source_rights_state",
        "strict_min_characters",
        "strict_max_characters"
      ]
    }
  },
  "semantic_edges": [
    "owns_groove",
    "supports",
    "answers",
    "contrasts",
    "replaces",
    "preserves",
    "enters_during",
    "drops_out_before",
    "evolves_into"
  ],
