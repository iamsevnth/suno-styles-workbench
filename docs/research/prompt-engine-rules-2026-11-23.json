  "hybrid_policy": {
    "one_primary_timing_grammar": true,
    "one_primary_low_end_owner": true,
    "require_secondary_role_map": true,
    "primary_role_choices": [
      "rhythm",
      "bass_timbre",
      "harmony",
      "hook",
      "vocal",
      "percussion_accent",
      "drop_architecture",
      "atmosphere"
    ]
  },
  "compiler": {
    "preferred_clause_priority": [
      "primary_groove_and_genre",
      "recurring_hook",
      "bass_interaction",
      "section_progression",
      "mix_priorities",
      "decorative_detail"
    ],
    "recommended_style_characters_heuristic": [
      600,
      850
    ],
    "move_negative_terms_to_separate_field": true,
    "do_not_truncate_hard_constraints_silently": true
  },
  "rhythm_patterns": {
    "modern_trap_machine_hats": {
      "timbre": "electronic_808",
      "base_grid": "16ths",
      "ratchet": "short_32nd_at_phrase_turns",
      "open_hat": "selected_offbeats_short_chokes"
    },
    "deep_140": {
      "base_grid": "sparse_or_swung",
      "ratchet": "selected_accents_only",
      "priority": "negative_space_and_sub"
    },
    "ukg": {
      "base_grid": "swung_8th_16th",
      "kick": "two_step",
      "snare": "ghosts",
      "priority": "shuffle_survives_drop"
    },
    "dnb": {
      "base_grid": "fast_break",
      "priority": "rolling_break_continuity",
      "halftime": "explicit_section_or_tempo_feel"
    }
  },
  "section_plan_template": {
    "main": {
      "drums": "stable_identity_with_local_fills",
      "bass": "signature_groove",
      "hook": "present"
    },
    "build": {
      "drums": "escalating_subdivisions",
      "bass": "rising_or_thinning_ostinato",
      "hook": "narrowed_or_chopped"
    },
    "predrop": {
      "drums": "short_reduction",
      "bass": "sub_dropout_or_pickup",
      "hook": "signature_fragment"
    },
    "drop1": {
      "drums": "dominant_backbeat",
      "bass": "clear_call_response",
      "hook": "returns"
    },
    "breakdown": {
      "drums": "reduced",
      "bass": "filtered",
      "hook": "exposed"
    },
    "drop2": {
      "drums": "variation_not_total_reset",
      "bass": "displaced_or_new_answer",
      "hook": "developed"
    }
  },
