  "lint_rules": [
    {
      "id": "STYLE_LENGTH_EXCEEDED",
      "severity": "error",
      "trigger": "len(style) > limits.style_max_chars",
      "repair": "shrink clauses with preservation of mandatory identities",
      "evaluation_type": "deterministic"
    },
    {
      "id": "LYRICS_LENGTH_EXCEEDED",
      "severity": "error",
      "trigger": "len(lyrics) > limits.lyrics_max_chars",
      "repair": "reduce lyrics or split workflow",
      "evaluation_type": "deterministic"
    },
    {
      "id": "NEGATIVE_STYLE_LENGTH_EXCEEDED",
      "severity": "error",
      "trigger": "len(negative_style) > limits.negative_style_max_chars",
      "repair": "deduplicate and shorten exclusions",
      "evaluation_type": "deterministic"
    },
    {
      "id": "SIMPLE_CUSTOM_COLLISION",
      "severity": "error",
      "trigger": "mode == simple and (style or lyrics)",
      "repair": "route as custom or remove disallowed fields",
      "evaluation_type": "deterministic"
    },
    {
      "id": "AUDIO_INFLUENCE_INVALID_FOR_CUSTOM",
      "severity": "error",
      "trigger": "mode == custom and audio_influence != null and voice_id == null",
      "repair": "use source-conditioned cover/mashup/extension or remove audio_influence",
      "evaluation_type": "deterministic"
    },
    {
      "id": "CUSTOM_VOCAL_GENDER_UNSUPPORTED_ON_MASHUP",
      "severity": "warning",
      "trigger": "mode == mashup and vocal_gender != null",
      "repair": "move supported performance hint to style or use permitted voice mode",
      "evaluation_type": "deterministic"
    },
    {
      "id": "VOICE_VS_INSTRUMENTAL",
      "severity": "warning",
      "trigger": "voice_id != null and instrumental == true",
      "repair": "explain voice_id will take precedence; correct intent",
