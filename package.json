{
  "name": "suno-styles-workbench",
  "private": true,
  "version": "5.3.0",
  "description": "Browser-only Suno v6 toolkit: Styles compiler with source-based Prompt Fidelity Inspector, source-preserving Lyrics Arranger, and production guide.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/iamsevnth/suno-styles-workbench.git"
  },
  "homepage": "https://sunoworkbench.com/",
  "scripts": {
    "dev": "vite --port=3000",
    "build": "vite build && node scripts/build-routes.mjs && node scripts/build-offline.mjs && node scripts/check-csp.mjs",
    "preview": "vite preview",
    "test": "tsx --test tests/*.test.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
